{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.3.2",
  "identifier": "dev.lumen.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run fetch:openrgb",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3OTEwMEFCNTM2MDQ1MTMKUldRVFJXQlRxd0NSMTNsbG1GTTFnbHhFWnJ6RGlmZEVvR1hnZzd6UEF1Vkc4cWo5aThoaUJHd3UK",
      "endpoints": ["https://github.com/rahmidaniel/lumen/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One app for all your RGB devices",
    "longDescription": "Lumen drives every RGB device through OpenRGB and paints one scene across all of them: a virtual canvas, layered effects and profiles, plus device settings (polling rate, DPI, sleep timer), battery status, lights that follow the PC and boot lighting, from a small tray app. OpenRGB 1.0 is bundled.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/openrgb/": "openrgb/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "licenseFile": "packaging/installer-license.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
