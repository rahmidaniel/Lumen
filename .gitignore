# Bundled OpenRGB (fetched by scripts/fetch-openrgb.mjs). The empty folder stays
# tracked (.gitkeep) because tauri-build insists every bundle resource path exists.
src-tauri/resources/openrgb/*
!src-tauri/resources/openrgb/.gitkeep
