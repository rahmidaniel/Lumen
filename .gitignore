# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Tauri
src-tauri/gen/
src-tauri/target/

# Local setup logs
scripts/*.log

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
